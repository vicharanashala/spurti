# Spurti SP pipeline — required environment for the SAMAGAMA-SIDE scripts.
#
# Two deployments read this folder, from two different .env files:
#   * Samagama side (/var/samagama/server/.env, mode 600, samagama user):
#     the scripts in pipeline/samagama/ (zoom-update.js, zoom-fetch-transcripts.js,
#     zoom-ingest-all-transcripts.js, sync-sakshi-zoom-mirror.js,
#     sync-collaborator-mirrors.js, sync-spurti-from-sakshi.js). This file is their example.
#   * Sakshi side (/home/sakshi/spurti/.env — the web app's own .env):
#     sp-rubric-build-mirror.cjs, spandan-poll-fetch.cjs, sync-attendance-records.cjs,
#     sync-poll-records.cjs, vibe-fetch.cjs, vtalk-attendance-build.cjs,
#     certificate-freeze.cjs. Their keys are in ../.env.example.
# NEVER commit a filled-in .env — only this example.

# MongoDB. The pipeline derives per-DB connection strings from this base by
# swapping the trailing /<db>?<query>, and connects with authSource=admin to:
#   chatengine, zoom_data, sakshi_spurti, form_responses,
#   rohit_spandan, aditya_platform
MONGO_URI=mongodb://<user>:<password>@<host>:27017/chatengine?authSource=admin

# Zoom Server-to-Server OAuth (used by zoom-update.js, zoom-fetch-transcripts.js,
# zoom-ingest-all-transcripts.js)
ZOOM_ACCOUNT_ID=<zoom-s2s-account-id>
ZOOM_CLIENT_ID=<zoom-s2s-client-id>
ZOOM_CLIENT_SECRET=<zoom-s2s-client-secret>

# Optional feature flags (samagama side)
# SKIP_SAKSHI_MIRROR=1      # zoom-update.js: skip the zoom_data -> sakshi_spurti mirror
# SKIP_TRANSCRIPT_INGEST=1  # zoom-update.js: skip chained transcript ingest
# DRY_RUN=1                 # sync-* scripts: count + sample, no writes

# Run-time knobs the sakshi-side scripts accept on the command line rather than
# from .env (documented here so nobody hunts for them):
#   APPLY=1                 sp-rubric-build-mirror.cjs: write; default is a dry run + CSV
#   OUT_DIR=./sp-runs       where the pre-APPLY backups and ledger CSVs land
#   START_DATE=2026-05-15   sp-rubric-build-mirror.cjs: programme start override
#   PROGRAM_START=...       certificate-freeze.cjs / vtalk-attendance-build.cjs
#   TODAY=YYYY-MM-DD        pretend today's date (replays)
#   FULL=1                  vibe-fetch.cjs: full pull instead of incremental
#   DRY=1                   certificate-freeze.cjs: preview only
# Secrets the sakshi-side scripts need (SPANDAN_RESEARCH_KEY, SPANDAN_CUTOFF,
# ATT_HYBRID_CUTOVER, QUIZ_SP_START) are in ../.env.example.
