# Local development defaults. Copy to `.env` and edit if needed.
# The same file is read by the web app AND by sp-refresh.sh / the pipeline
# scripts that run from this checkout, so the scorer's keys live here too.
# Feature flags are read once at process start — flipping one needs a restart.
# Production values that differ from these are in .env.ssh.example.

PORT=5290
MONGO_URI=mongodb://127.0.0.1:27017/analysis_summership

# Look students up by email. Kept `false` in production: direct student search
# would let anyone read another student's record.
ALLOW_STUDENT_SEARCH=true

# Students are identified by the `chatengine_token` cookie that SAMAGAMA sets;
# Spurti validates it against this endpoint (Samagama's own service, same host).
# With no Samagama running locally there is no student session — use search.
SAMAGAMA_AUTH_URL=http://127.0.0.1:5001/api/auth/me

# Admin dashboard. Sent by the client as `x-admin-email` / `x-admin-token`.
# Both must be set or the admin routes stay closed.
ADMIN_EMAIL=
ADMIN_TOKEN=

# Seed scripts only: 1 = demo mode (seed-demo-local.mjs). Leave unset otherwise.
DEMO=

# --- Achievements: milestone/podium cards + public verify pages ---
# Two independent switches. The tab and the Share/Download buttons are gated
# separately, so sharing can be paused without hiding what students earned.
ACHIEVEMENTS_ENABLED=0
ACHIEVEMENTS_SHARING=0
# Comma-separated addresses that see the tab while it is otherwise off.
ACHIEVEMENTS_EMAILS=
# Absolute origin for the og: tags on verify pages, so a shared link unfurls
# with the card image. Inferred from the request when unset.
PUBLIC_BASE_URL=
# Where generated card PNGs are written.
CARD_DIR=
# Set to 0 to stop logging verify-page views entirely.
VERIFY_VIEW_LOG=1

# --- Mandatory survey pop-ups (perception triangulation) ---
# Three independent surveys, same mechanism, one block each. The block's
# prefix decides which Student flag it drives:
#   SURVEY_* -> surveyCompleted   POLL2_* -> poll2Completed   POLL3_* -> poll3Completed
# Leave <PREFIX>_ENABLED unset/0 to keep that modal off entirely. The Google Form +
# Apps Script loop and the 10-min reconciliation script live outside this repo.
SURVEY_ENABLED=0
# Published Google Form URL (the .../viewform link).
SURVEY_FORM_URL=
# Email field's prefill id, e.g. entry.1234567890 — from the form's "Get pre-filled link".
SURVEY_EMAIL_ENTRY=
# 'hard' = blocking/mandatory (default), 'soft' = dismissable.
SURVEY_ENFORCEMENT=hard
# Auto-expiry (ISO 8601 with offset). After this the modal stops showing — no
# redeploy needed. Empty = no expiry. e.g. 2026-06-30T23:59:59+05:30
SURVEY_DEADLINE=
# Shared secret the Google Apps Script webhook must send to mark a student done.
SURVEY_WEBHOOK_SECRET=
# Private Apps Script web app that returns {emails:[...]} of actual submitters
# (used for the on-demand "I've submitted" check and the 10-min sheet-sync cron).
SURVEY_RESPONSES_URL=
SURVEY_RESPONSES_SECRET=

POLL2_ENABLED=0
POLL2_FORM_URL=
POLL2_EMAIL_ENTRY=
POLL2_ENFORCEMENT=hard
POLL2_DEADLINE=
POLL2_WEBHOOK_SECRET=
POLL2_RESPONSES_URL=
POLL2_RESPONSES_SECRET=

POLL3_ENABLED=0
POLL3_FORM_URL=
POLL3_EMAIL_ENTRY=
POLL3_ENFORCEMENT=hard
POLL3_DEADLINE=
POLL3_WEBHOOK_SECRET=
POLL3_RESPONSES_URL=
POLL3_RESPONSES_SECRET=

# --- Goal-card window (research feature) ---
# The card shows for students carrying an arm on their record, only between
# E2_START and E2_START + E2_DAYS. Unset E2_START = card off everywhere. Arm
# assignment is done outside this repo.
E2_START=
E2_DAYS=7

# --- sp-refresh.sh (the sakshi-side 6-hourly refresh; runs from this checkout) ---
# Each step's outcome is recorded here; the admin dashboard reads it.
STEP_HEALTH_FILE=sp-runs/step-health.tsv
# After ALERT_AFTER consecutive failures of a step the refresh POSTs a small JSON
# body to ALERT_WEBHOOK_URL (a Google Apps Script web app, Slack, Discord...).
# The box has no mailer, so this is the only way an alert leaves it. Unset = log only.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=
ALERT_AFTER=2

# --- Scorer (pipeline/sp-rubric-build-mirror.cjs + spandan-poll-fetch.cjs) ---
# Key for the Spandan Research Session Export API the poll fetch reads. Required
# wherever the refresh runs; without it the fetch step is skipped (non-fatal) and
# scoring uses whatever spandan_polls already holds.
SPANDAN_RESEARCH_KEY=
# Source cutover dates baked into the rubric. Poll SP moved from Zoom polls to
# Spandan on SPANDAN_CUTOFF (default 2026-07-16); attendance moved to the hybrid
# Spandan-correctness source on ATT_HYBRID_CUTOVER (default 2026-07-29). Only
# override these to replay history — a rebuild re-scores every date.
SPANDAN_CUTOFF=
ATT_HYBRID_CUTOVER=
# First quiz day that earns SP (production scorer; default 2026-09-15).
QUIZ_SP_START=

# Removed: SPURTI_AUTH_SECRET and SPURTI_COOKIE_SECURE. Spurti issued its own
# session before 2026-06-29; it now reads Samagama's cookie (SAMAGAMA_AUTH_URL
# above) and nothing in the code reads either variable any more.
