# samagama.in deployment — the sakshi-side checkout at /home/sakshi/spurti,
# run by PM2 as the `sakshi` user. Copy to `.env` on the server and fill in.
# Everything .env.example lists applies here too; these are the values that
# differ from local. Feature flags are read at process start: pm2 restart spurti.

PORT=5003
MONGO_URI=mongodb://<user>:<password>@127.0.0.1:27017/sakshi_spurti?authSource=sakshi_spurti

# Privacy: never enable student search in production.
ALLOW_STUDENT_SEARCH=false

# Samagama's auth endpoint on the same host (nginx serves both under samagama.in).
SAMAGAMA_AUTH_URL=http://127.0.0.1:5001/api/auth/me

ADMIN_EMAIL=<admin address>
ADMIN_TOKEN=<long random token>

# Live since 12 Aug 2026 (tab) / sharing on; keep both at 1.
ACHIEVEMENTS_ENABLED=1
ACHIEVEMENTS_SHARING=1
PUBLIC_BASE_URL=https://samagama.in
CARD_DIR=/home/sakshi/spurti/server/data/cards
VERIFY_VIEW_LOG=1

# Surveys: fill a block only while that survey is open.
SURVEY_ENABLED=0
POLL2_ENABLED=0
POLL3_ENABLED=0

# Goal-card window: set E2_START only after arms have been written to the student records.
E2_START=
E2_DAYS=7

# sp-refresh.sh
STEP_HEALTH_FILE=/home/sakshi/spurti/sp-runs/step-health.tsv
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=
ALERT_AFTER=2

# Scorer
SPANDAN_RESEARCH_KEY=<spandan research api key>
SPANDAN_CUTOFF=
ATT_HYBRID_CUTOVER=
QUIZ_SP_START=

# Removed 2026-06-29 — do NOT reintroduce (see CONTEXT.md, Auth):
# SPURTI_AUTH_SECRET, SPURTI_COOKIE_SECURE
